{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/build.ts",
    "src/mount.ts",
    "src/providers/runtime-public.ts",
    "src/schema.ts",
    "src/telemetry.ts",
    "src/target.ts",
    "src/providers/workflow-public.ts",
    "src/agent.ts",
    "src/app.ts",
    "src/identity.ts",
    "src/authorization.ts",
    "src/cache.ts",
    "src/external_credential.ts",
    "src/indexeddb.ts",
    "src/rpc_support.ts",
    "src/runtime.ts",
    "src/runtime_provider.ts",
    "src/s3.ts",
    "src/secrets.ts",
    "src/test.ts",
    "src/workflow.ts",
    "src/client/index.ts",
    "src/client/rest.ts",
    "src/client/grpc.ts",
    "src/vite.js"
  ],
  "tsconfig": "tsconfig.json",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "externalPattern": [
    "**/src/internal/**"
  ],
  "disableSources": true,
  "sort": [
    "source-order"
  ],
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": false,
    "invalidLink": true
  }
}
