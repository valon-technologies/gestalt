{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "docs/entrypoints/@valon-technologies/gestalt",
    "docs/entrypoints/schema",
    "docs/entrypoints/telemetry",
    "docs/entrypoints/services/agent",
    "docs/entrypoints/services/app",
    "docs/entrypoints/services/authentication",
    "docs/entrypoints/services/authorization",
    "docs/entrypoints/services/cache",
    "docs/entrypoints/services/indexeddb",
    "docs/entrypoints/services/external_credential",
    "docs/entrypoints/services/rpc_support",
    "docs/entrypoints/services/runtime",
    "docs/entrypoints/services/runtime_provider",
    "docs/entrypoints/services/s3",
    "docs/entrypoints/services/secrets",
    "docs/entrypoints/services/test",
    "docs/entrypoints/services/workflow"
  ],
  "displayBasePath": "docs/entrypoints",
  "tsconfig": "tsconfig.json",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "externalPattern": [
    "**/src/internal/**"
  ],
  "disableSources": true,
  "sort": [
    "source-order"
  ],
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": false,
    "invalidLink": true
  }
}
