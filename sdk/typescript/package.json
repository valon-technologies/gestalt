{
  "name": "@valon-technologies/gestalt",
  "version": "0.0.1-alpha.74",
  "description": "TypeScript SDK for Gestalt executable providers",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valon-technologies/gestalt.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts",
    "./mount": "./src/mount.ts",
    "./runtime": "./src/providers/runtime-public.ts",
    "./schema": "./src/schema.ts",
    "./telemetry": "./src/telemetry.ts",
    "./target": "./src/target.ts",
    "./workflow": "./src/providers/workflow-public.ts",
    "./services/agent": "./src/agent.ts",
    "./services/app": "./src/app.ts",
    "./services/identity": "./src/identity.ts",
    "./services/authorization": "./src/authorization.ts",
    "./services/cache": "./src/cache.ts",
    "./services/external_credential": "./src/external_credential.ts",
    "./services/indexeddb": "./src/indexeddb.ts",
    "./services/rpc_support": "./src/rpc_support.ts",
    "./services/runtime": "./src/runtime.ts",
    "./services/runtime_provider": "./src/runtime_provider.ts",
    "./services/s3": "./src/s3.ts",
    "./services/secrets": "./src/secrets.ts",
    "./services/test": "./src/test.ts",
    "./services/workflow": "./src/workflow.ts",
    "./client": "./src/client/index.ts",
    "./client/rest": "./src/client/rest.ts",
    "./client/grpc": "./src/client/grpc.ts",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "bin": {
    "gestalt": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:proto": "buf generate --template ../proto/buf.typescript.gen.yaml ../proto",
    "docs:lint": "eslint --max-warnings=0 \"src/**/*.ts\"",
    "docs:build": "typedoc --options typedoc.json --out \"${TYPEDOC_OUT_DIR:-docs/_build/html}\"",
    "docs:build:deploy": "TYPEDOC_OUT_DIR=../../docs/public/api/typescript bun run docs:build",
    "docs:check": "bun run docs:lint && bun run docs:build",
    "typecheck": "tsc --noEmit",
    "typecheck:loose": "tsc --noEmit --strict false --exactOptionalPropertyTypes false --noUncheckedIndexedAccess false",
    "test": "bun run scripts/run-tests.ts",
    "check": "bun run test && bun run typecheck && bun run typecheck:loose"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "@connectrpc/connect": "2.1.0",
    "@connectrpc/connect-node": "2.1.0",
    "@opentelemetry/api": "1.9.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.46.1",
    "@types/bun": "1.3.2",
    "eslint": "9.38.0",
    "eslint-plugin-tsdoc": "0.4.0",
    "typedoc": "0.28.14",
    "typescript": "5.9.3",
    "vite": "7.0.4"
  },
  "peerDependencies": {
    "typescript": "^5.9.0",
    "vite": "^5.4.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
