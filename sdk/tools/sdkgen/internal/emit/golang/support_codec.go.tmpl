// The nil-safe wire converters for the well-known types, shared by the
// generated codec files. The public error model lives in rpc_support.go.

package client

import (
	"time"

	rpcstatus "google.golang.org/genproto/googleapis/rpc/status"
	"google.golang.org/protobuf/types/known/durationpb"
	"google.golang.org/protobuf/types/known/structpb"
	"google.golang.org/protobuf/types/known/timestamppb"
)

func toWireTimestamp(value *time.Time) *timestamppb.Timestamp {
	if value == nil {
		return nil
	}
	return timestamppb.New(*value)
}

func fromWireTimestamp(value *timestamppb.Timestamp) *time.Time {
	if value == nil {
		return nil
	}
	t := value.AsTime()
	return &t
}

func toWireDuration(value *time.Duration) *durationpb.Duration {
	if value == nil {
		return nil
	}
	return durationpb.New(*value)
}

func fromWireDuration(value *durationpb.Duration) *time.Duration {
	if value == nil {
		return nil
	}
	d := value.AsDuration()
	return &d
}

// toWireStruct converts a native JSON object to its wire form. A nil map
// means absent.
func toWireStruct(value map[string]any) *structpb.Struct {
	if value == nil {
		return nil
	}
	fields := make(map[string]*structpb.Value, len(value))
	for key, item := range value {
		fields[key] = toWireValue(item)
	}
	return &structpb.Struct{Fields: fields}
}

// fromWireStruct converts a wire Struct to its native form. Absence maps to
// a nil map.
func fromWireStruct(value *structpb.Struct) map[string]any {
	if value == nil {
		return nil
	}
	return value.AsMap()
}

// toWireValue converts a native JSON value to its wire form. Absent and JSON
// null conflate: nil becomes JSON null. Values with no JSON representation
// also become JSON null, keeping conversion total.
func toWireValue(value any) *structpb.Value {
	v, err := structpb.NewValue(value)
	if err != nil {
		return structpb.NewNullValue()
	}
	return v
}

// fromWireValue converts a wire Value to its native form. Absent and JSON
// null conflate: both become nil.
func fromWireValue(value *structpb.Value) any {
	if value == nil {
		return nil
	}
	return value.AsInterface()
}

func toWireStatus(value *RpcStatus) *rpcstatus.Status {
	if value == nil {
		return nil
	}
	return &rpcstatus.Status{Code: int32(value.Code), Message: value.Message}
}

func fromWireStatus(value *rpcstatus.Status) *RpcStatus {
	if value == nil {
		return nil
	}
	return &RpcStatus{Code: GestaltErrorCode(value.GetCode()), Message: value.GetMessage()}
}
