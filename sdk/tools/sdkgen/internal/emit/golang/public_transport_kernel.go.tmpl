package generated

import (
	"encoding/base64"
	"encoding/json"
	"fmt"
	"net/url"
	"strconv"
	"sort"
	"strings"
	"unicode"
	"unicode/utf8"

	"google.golang.org/protobuf/encoding/protojson"
	"google.golang.org/protobuf/proto"
)

// QueryParam is one query-string pair.
type QueryParam struct {
	Name  string
	Value string
}

// Header is one HTTP header name/value pair.
type Header struct {
	Name  string
	Value string
}

// PreparedRESTRequest is a schema-derived REST request plan.
type PreparedRESTRequest struct {
	Verb  string
	Path  string
	Query []QueryParam
	Body  json.RawMessage // nil means no body; []byte("{}") means empty body object
}

// RawRESTResponse is a raw REST response from an adapter.
type RawRESTResponse struct {
	Status  int
	Headers []Header
	Body    []byte
}

const (
	responseKindHeader          = "X-Gestalt-Response-Kind"
	responseKindOperationResult = "operation-result"
)

var protoJSONUnmarshal = protojson.UnmarshalOptions{DiscardUnknown: true}

// PrepareRESTRequest builds REST request components from method metadata.
func PrepareRESTRequest(method Method, request proto.Message) (PreparedRESTRequest, error) {
	if method.HTTPVerb == "" || method.HTTPPath == "" {
		return PreparedRESTRequest{}, newGestaltError(
			GestaltErrorCodeInvalidArgument,
			fmt.Sprintf("method %s has no HTTP binding", method.FullMethod),
		)
	}
	requestJSON, err := protoMessageToMap(request)
	if err != nil {
		return PreparedRESTRequest{}, err
	}
	path, err := buildRESTPath(method, requestJSON)
	if err != nil {
		return PreparedRESTRequest{}, err
	}
	query, err := buildRESTQuery(method, requestJSON)
	if err != nil {
		return PreparedRESTRequest{}, err
	}
	body, err := buildRESTBody(method, requestJSON)
	if err != nil {
		return PreparedRESTRequest{}, err
	}
	return PreparedRESTRequest{
		Verb:  method.HTTPVerb,
		Path:  path,
		Query: query,
		Body:  body,
	}, nil
}

// DecodeRESTResponse decodes a raw REST response into the output message.
func DecodeRESTResponse(method Method, response proto.Message, raw RawRESTResponse) error {
	if isOperationResult(raw.Headers) {
		if !method.ResponseIsOperationResult {
			return newGestaltError(
				GestaltErrorCodeInternal,
				"unexpected operation-result response kind",
			)
		}
		responseJSON := synthesizeOperationResultJSON(raw.Status, raw.Body, raw.Headers)
		payload, err := json.Marshal(responseJSON)
		if err != nil {
			return newGestaltError(GestaltErrorCodeInternal, err.Error())
		}
		if err := protoJSONUnmarshal.Unmarshal(payload, response); err != nil {
			return newGestaltError(GestaltErrorCodeInternal, err.Error())
		}
		return nil
	}
	if raw.Status >= 400 || !isRESTSuccessStatus(raw.Status) {
		return ParseGatewayError(raw.Status, raw.Body)
	}
	if len(strings.TrimSpace(string(raw.Body))) == 0 {
		if err := protoJSONUnmarshal.Unmarshal([]byte("{}"), response); err != nil {
			return newGestaltError(GestaltErrorCodeInternal, "response body does not match the expected schema")
		}
		return nil
	}
	if err := protoJSONUnmarshal.Unmarshal(raw.Body, response); err != nil {
		return newGestaltError(GestaltErrorCodeInternal, "response body does not match the expected schema")
	}
	return nil
}

// ParseGatewayError parses a gateway failure body.
func ParseGatewayError(status int, body []byte) *GestaltError {
	var parsed map[string]any
	if len(strings.TrimSpace(string(body))) > 0 {
		_ = json.Unmarshal(body, &parsed)
	}
	code := resolveGatewayErrorCode(status, parsed)
	message := extractGatewayErrorMessage(parsed)
	if message == "" {
		message = fmt.Sprintf("request failed with status %d", status)
	}
	return newGestaltError(code, message)
}

func protoMessageToMap(message proto.Message) (map[string]any, error) {
	payload, err := protojson.Marshal(message)
	if err != nil {
		return nil, newGestaltError(GestaltErrorCodeInvalidArgument, err.Error())
	}
	var out map[string]any
	if err := json.Unmarshal(payload, &out); err != nil {
		return nil, newGestaltError(GestaltErrorCodeInvalidArgument, err.Error())
	}
	return out, nil
}

func buildRESTPath(method Method, request map[string]any) (string, error) {
	path := method.HTTPPath
	for _, field := range method.HTTPPathFields {
		value, ok := fieldValue(request, field)
		if !ok || value == nil {
			return "", newGestaltError(
				GestaltErrorCodeInvalidArgument,
				fmt.Sprintf("missing path parameter %s", field.Name),
			)
		}
		scalar, ok := value.(string)
		if !ok {
			if isScalarJSON(value) {
				scalar = formatQueryScalar(value)
			} else {
				return "", newGestaltError(
					GestaltErrorCodeInvalidArgument,
					fmt.Sprintf("path parameter %s must be scalar", field.Name),
				)
			}
		}
		path = strings.ReplaceAll(path, "{"+field.Name+"}", url.PathEscape(scalar))
	}
	return path, nil
}

func buildRESTQuery(method Method, request map[string]any) ([]QueryParam, error) {
	var out []QueryParam
	for _, field := range method.HTTPQueryFields {
		value, ok := fieldValue(request, field)
		if !ok || value == nil {
			continue
		}
		if err := appendQueryParams(&out, field.JSONName, value); err != nil {
			return nil, err
		}
	}
	return out, nil
}

func buildRESTBody(method Method, request map[string]any) (json.RawMessage, error) {
	if method.HTTPBody == "*" {
		excluded := excludedFieldKeys(method)
		body := map[string]any{}
		for key, value := range request {
			if excluded[key] || value == nil {
				continue
			}
			body[key] = value
		}
		payload, err := json.Marshal(body)
		if err != nil {
			return nil, newGestaltError(GestaltErrorCodeInternal, err.Error())
		}
		return payload, nil
	}
	if method.HTTPBody == "" {
		return nil, nil
	}
	value, ok := fieldValue(request, PublicField{Name: method.HTTPBody, JSONName: snakeToCamel(method.HTTPBody)})
	if !ok {
		value = request[method.HTTPBody]
	}
	if value == nil {
		return json.RawMessage("{}"), nil
	}
	if object, ok := value.(map[string]any); ok {
		payload, err := json.Marshal(object)
		if err != nil {
			return nil, newGestaltError(GestaltErrorCodeInternal, err.Error())
		}
		return payload, nil
	}
	payload, err := json.Marshal(map[string]any{method.HTTPBody: value})
	if err != nil {
		return nil, newGestaltError(GestaltErrorCodeInternal, err.Error())
	}
	return payload, nil
}

func excludedFieldKeys(method Method) map[string]bool {
	keys := map[string]bool{}
	for _, field := range method.HTTPPathFields {
		for _, alias := range fieldAliases(field) {
			keys[alias] = true
		}
	}
	for _, field := range method.HTTPQueryFields {
		for _, alias := range fieldAliases(field) {
			keys[alias] = true
		}
	}
	for _, name := range append(append([]string{}, method.Fill...), method.Reject...) {
		keys[name] = true
		keys[snakeToCamel(name)] = true
	}
	return keys
}

func fieldAliases(field PublicField) []string {
	return []string{field.Name, field.JSONName, snakeToCamel(field.Name)}
}

func fieldValue(request map[string]any, field PublicField) (any, bool) {
	if value, ok := request[field.JSONName]; ok {
		return value, true
	}
	if value, ok := request[field.Name]; ok {
		return value, true
	}
	if value, ok := request[snakeToCamel(field.Name)]; ok {
		return value, true
	}
	return nil, false
}

func appendQueryParams(out *[]QueryParam, prefix string, value any) error {
	switch typed := value.(type) {
	case nil:
		return nil
	case []any:
		for _, item := range typed {
			if item == nil {
				continue
			}
			if _, isMap := item.(map[string]any); isMap {
				return newGestaltError(
					GestaltErrorCodeInvalidArgument,
					fmt.Sprintf("repeated query field %s must contain scalars", prefix),
				)
			}
			if _, isSlice := item.([]any); isSlice {
				return newGestaltError(
					GestaltErrorCodeInvalidArgument,
					fmt.Sprintf("repeated query field %s must contain scalars", prefix),
				)
			}
			if err := appendQueryParams(out, prefix, item); err != nil {
				return err
			}
		}
	case map[string]any:
		keys := make([]string, 0, len(typed))
		for key := range typed {
			keys = append(keys, key)
		}
		sort.Strings(keys)
		for _, key := range keys {
			nested := typed[key]
			nestedPrefix := key
			if prefix != "" {
				nestedPrefix = prefix + "." + key
			}
			if err := appendQueryParams(out, nestedPrefix, nested); err != nil {
				return err
			}
		}
	default:
		if isScalarJSON(typed) {
			*out = append(*out, QueryParam{Name: prefix, Value: formatQueryScalar(typed)})
		}
	}
	return nil
}

func isScalarJSON(value any) bool {
	switch value.(type) {
	case string, bool, float64, json.Number, int, int32, int64, uint, uint32, uint64:
		return true
	default:
		return false
	}
}

func formatQueryScalar(value any) string {
	switch typed := value.(type) {
	case bool:
		if typed {
			return "true"
		}
		return "false"
	case string:
		return typed
	case float64:
		return strconv.FormatFloat(typed, 'f', -1, 64)
	default:
		return fmt.Sprint(value)
	}
}

func snakeToCamel(name string) string {
	parts := strings.Split(name, "_")
	if len(parts) == 0 {
		return name
	}
	out := parts[0]
	for _, part := range parts[1:] {
		if part == "" {
			continue
		}
		runes := []rune(part)
		out += string(unicode.ToUpper(runes[0])) + string(runes[1:])
	}
	return out
}

func isOperationResult(headers []Header) bool {
	for _, header := range headers {
		if strings.EqualFold(header.Name, responseKindHeader) &&
			strings.EqualFold(header.Value, responseKindOperationResult) {
			return true
		}
	}
	return false
}

func synthesizeOperationResultJSON(status int, body []byte, headers []Header) map[string]any {
	grouped := map[string][]string{}
	for _, header := range headers {
		if strings.EqualFold(header.Name, responseKindHeader) {
			continue
		}
		grouped[header.Name] = append(grouped[header.Name], header.Value)
	}
	headerJSON := map[string]any{}
	for key, values := range grouped {
		headerJSON[key] = map[string]any{"values": values}
	}
	return map[string]any{
		"status":  status,
		"body":    base64.StdEncoding.EncodeToString(body),
		"headers": headerJSON,
	}
}

func extractGatewayErrorMessage(parsed map[string]any) string {
	if parsed == nil {
		return ""
	}
	if message, ok := parsed["message"].(string); ok && strings.TrimSpace(message) != "" {
		return message
	}
	if errValue, ok := parsed["error"]; ok {
		switch typed := errValue.(type) {
		case string:
			if strings.TrimSpace(typed) != "" {
				return typed
			}
		case map[string]any:
			if message, ok := typed["message"].(string); ok && strings.TrimSpace(message) != "" {
				return message
			}
		}
	}
	return ""
}

func resolveGatewayErrorCode(status int, parsed map[string]any) GestaltErrorCode {
	if parsed != nil {
		if code, ok := parsed["code"]; ok {
			if resolved, ok := gestaltCodeFromAny(code); ok {
				return resolved
			}
		}
		if errValue, ok := parsed["error"].(map[string]any); ok {
			if code, ok := errValue["code"]; ok {
				if resolved, ok := gestaltCodeFromAny(code); ok {
					return resolved
				}
			}
		}
	}
	return httpStatusToGestaltCode(status)
}

func gestaltCodeFromAny(code any) (GestaltErrorCode, bool) {
	switch typed := code.(type) {
	case float64:
		return GestaltErrorCode(int(typed)), true
	case string:
		return gestaltCodeFromString(typed)
	default:
		return 0, false
	}
}

func gestaltCodeFromString(raw string) (GestaltErrorCode, bool) {
	trimmed := strings.TrimSpace(raw)
	if trimmed == "" {
		return 0, false
	}
	if digits, err := strconv.Atoi(trimmed); err == nil {
		return GestaltErrorCode(digits), true
	}
	if code, ok := gestaltCodeFromNormalized(strings.ToUpper(strings.ReplaceAll(trimmed, "-", "_"))); ok {
		return code, true
	}
	return gestaltCodeFromNormalized(normalizeCodeName(trimmed))
}

func gestaltCodeFromNormalized(normalized string) (GestaltErrorCode, bool) {
	switch normalized {
	case "CANCELED", "CANCELLED":
		return GestaltErrorCodeCanceled, true
	case "UNKNOWN":
		return GestaltErrorCodeUnknown, true
	case "INVALID_ARGUMENT":
		return GestaltErrorCodeInvalidArgument, true
	case "DEADLINE_EXCEEDED":
		return GestaltErrorCodeDeadlineExceeded, true
	case "NOT_FOUND":
		return GestaltErrorCodeNotFound, true
	case "ALREADY_EXISTS":
		return GestaltErrorCodeAlreadyExists, true
	case "PERMISSION_DENIED":
		return GestaltErrorCodePermissionDenied, true
	case "RESOURCE_EXHAUSTED":
		return GestaltErrorCodeResourceExhausted, true
	case "FAILED_PRECONDITION":
		return GestaltErrorCodeFailedPrecondition, true
	case "ABORTED":
		return GestaltErrorCodeAborted, true
	case "OUT_OF_RANGE":
		return GestaltErrorCodeOutOfRange, true
	case "UNIMPLEMENTED":
		return GestaltErrorCodeUnimplemented, true
	case "INTERNAL":
		return GestaltErrorCodeInternal, true
	case "UNAVAILABLE":
		return GestaltErrorCodeUnavailable, true
	case "DATA_LOSS":
		return GestaltErrorCodeDataLoss, true
	case "UNAUTHENTICATED":
		return GestaltErrorCodeUnauthenticated, true
	default:
		return 0, false
	}
}

func isRESTSuccessStatus(status int) bool {
	return status >= 200 && status < 300
}

func httpStatusToGestaltCode(status int) GestaltErrorCode {
	switch status {
	case 400:
		return GestaltErrorCodeInvalidArgument
	case 401:
		return GestaltErrorCodeUnauthenticated
	case 403:
		return GestaltErrorCodePermissionDenied
	case 404:
		return GestaltErrorCodeNotFound
	case 409:
		return GestaltErrorCodeAlreadyExists
	case 412:
		return GestaltErrorCodeFailedPrecondition
	case 429:
		return GestaltErrorCodeResourceExhausted
	case 499:
		return GestaltErrorCodeCanceled
	case 500:
		return GestaltErrorCodeInternal
	case 501:
		return GestaltErrorCodeUnimplemented
	case 503:
		return GestaltErrorCodeUnavailable
	case 504:
		return GestaltErrorCodeDeadlineExceeded
	default:
		return GestaltErrorCodeUnknown
	}
}

func newGestaltError(code GestaltErrorCode, message string) *GestaltError {
	return &GestaltError{Code: code, Message: message}
}

func normalizeCodeName(name string) string {
	var out strings.Builder
	for i, ch := range name {
		if ch == '-' {
			out.WriteByte('_')
			continue
		}
		if unicode.IsUpper(ch) && i > 0 {
			prev, _ := utf8.DecodeLastRuneInString(name[:i])
			if unicode.IsLower(prev) || unicode.IsDigit(prev) {
				out.WriteByte('_')
			}
		}
		out.WriteRune(unicode.ToUpper(ch))
	}
	return out.String()
}
